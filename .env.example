# ============================================
# SISTEMA RAG - CONFIGURAÇÕES DE AMBIENTE
# ============================================
# Copie este arquivo para .env e preencha com suas credenciais
# cp .env.example .env

# --------------------------------------------
# BANCO DE DADOS MYSQL
# --------------------------------------------
MYSQL_ROOT_PASSWORD=root123
MYSQL_USER=admin
MYSQL_PASSWORD=admin123
MYSQL_DATABASE=sistema_rag

# Para conexão direta (sem Docker)
DATABASE_URL=mysql+pymysql://admin:admin123@localhost:3306/sistema_rag

# ============================================
# BACKEND CONFIGURATION (FastAPI)
# ============================================
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
PYTHONUNBUFFERED=1
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# Provedor de embeddings: openai, sentence_transformers, ollama
EMBEDDING_PROVIDER=openai

# Para embeddings locais (sentence-transformers)
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Para Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --------------------------------------------
# WHATSAPP - TWILIO (Opção 1)
# --------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# --------------------------------------------
# WHATSAPP - META CLOUD API (Opção 2 - Recomendado para produção)
# --------------------------------------------
META_ACCESS_TOKEN=EAxxxxxxxxxxxxxxxxxxxxxxxxxxxx
META_PHONE_NUMBER_ID=xxxxxxxxxxxxxxxxx
META_WEBHOOK_VERIFY_TOKEN=seu_token_secreto_aqui

# URL pública do webhook (use ngrok para testes locais)
WHATSAPP_WEBHOOK_URL=https://seu-dominio.com/webhooks/whatsapp

# --------------------------------------------
# OUTLOOK / MICROSOFT GRAPH
# --------------------------------------------
OUTLOOK_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
OUTLOOK_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OUTLOOK_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
OUTLOOK_USER_EMAIL=seu-email@dominio.com

# URL pública do webhook para notificações do Outlook
OUTLOOK_WEBHOOK_URL=https://seu-dominio.com/webhooks/outlook

# --------------------------------------------
# EMAIL SMTP (Fallback)
# --------------------------------------------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua_senha_de_app_gmail
SENDER_EMAIL=seu-email@gmail.com

# --------------------------------------------
# SEGURANÇA
# --------------------------------------------
SECRET_KEY=sua_chave_secreta_muito_longa_e_aleatoria_aqui_min_32_chars

# --------------------------------------------
# RAG CONFIG
# --------------------------------------------
LIMIAR_CONFIANCA=0.75
MAX_CHUNKS_RESPOSTA=5

# --------------------------------------------
# LOGGING
# --------------------------------------------
LOG_LEVEL=INFO

# ============================================
# FRONTEND CONFIGURATION (React)
# ============================================
REACT_APP_API_URL=http://localhost:8000
REACT_APP_ENV=development

# ============================================
# DOCKER NETWORK
# ============================================
RAG_NETWORK=rag_network
